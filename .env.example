# ── Lovable Cloud (Supabase-compatible API) ─────────────────────────────────
# The app talks to the backend only via @supabase/supabase-js. Lovable provisions
# a Supabase project; copy the real values from your Lovable editor (.env) or synced repo.
#
# Required for Vite (must be present at `npm run build` for production):
# https://docs.lovable.dev/tips-tricks/external-deployment-hosting

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Note: only variables prefixed with VITE_ are exposed to the browser.
